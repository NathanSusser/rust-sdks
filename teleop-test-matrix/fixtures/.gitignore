# Generated by make_fixtures.py, which is the source of truth. The publisher seq
# logs alone are ~25 MB — 4000 lines per run, one line per 200 Hz control sample,
# because the delivered-share denominator has to come from the publisher rather
# than from received sequence numbers.
#
# test_parse_runs.py regenerates the whole tree if it is missing, so a fresh
# clone runs the tests without any extra step.
snapshots/
runs/

# Scratch snapshots the gate-halt test rewrites.
_gate_halt_tmp/

# Scratch output from the CLI-level tests, which invoke main() for real.
_cli_*.jsonl
_cli_*.md
