#!/usr/bin/env python3
"""Force the modem's diag log mask off.

QCSuper's on_deinit tries this, but under full-mask load its reply is lost in the
inbound log stream ("unmatched response received") and the mask stays enabled --
the modem then streams megabytes per second forever, loading the baseband during
unrelated test runs. Send DIAG_LOG_CONFIG_F/DISABLE a few times and drain.
"""
import serial, crcmod, struct, sys, time

PORT = sys.argv[1] if len(sys.argv) > 1 else '/dev/ttyUSB0'
DIAG_LOG_CONFIG_F, LOG_CONFIG_DISABLE_OP = 0x73, 0
_crc = crcmod.predefined.mkCrcFun('x-25')


def frame(payload: bytes) -> bytes:
    c = _crc(payload)
    raw = payload + bytes([c & 0xFF, (c >> 8) & 0xFF])
    out = bytearray()
    for b in raw:
        out.extend([0x7D, b ^ 0x20] if b in (0x7D, 0x7E) else [b])
    out.append(0x7E)
    return bytes(out)


# One reader per DIAG port. Standalone, take the same lock the capture scripts take and
# refuse while a capture holds it (a second client corrupts both). A script that already
# holds the lock sets DIAG_LOCK_HELD=1 so this does not deadlock against its parent.
import os, fcntl
if os.environ.get('DIAG_LOCK_HELD') != '1':
    here = os.path.dirname(os.path.abspath(__file__))
    home_lock = os.path.expanduser('~/diag-capture/.ttyUSB0.lock')
    lock_path = os.environ.get('DIAG_LOCK') or (home_lock if os.path.isdir(os.path.dirname(home_lock)) else os.path.join(here, '.ttyUSB0.lock'))
    _lock = open(lock_path, 'w')
    try:
        fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"{PORT}: a capture holds the DIAG port (lock {lock_path}); not touching it")
        sys.exit(2)

s = serial.Serial(PORT, 115200, timeout=1)
req = frame(struct.pack('<B3xI', DIAG_LOG_CONFIG_F, LOG_CONFIG_DISABLE_OP))
for _ in range(3):
    s.write(req)
    s.flush()
    time.sleep(0.3)
    s.read(65536)

# Confirm silence rather than assuming it.
s.reset_input_buffer()
total, t0 = 0, time.time()
while time.time() - t0 < 2:
    total += len(s.read(65536))
print(f"{PORT}: {total} bytes in 2s ->", "STILL STREAMING" if total else "logging off")
sys.exit(1 if total else 0)
