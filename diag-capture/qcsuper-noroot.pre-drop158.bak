#!/usr/bin/env python3
"""Run QCSuper as an unprivileged dialout member, with no sudo and no pkexec.

QCSuper escalates to root in exactly two cases (inputs/usb_modem_pyserial.py):
  a) access(device, W_OK) fails  -- dialout membership satisfies this;
  b) detect_diag_interference() finds a process matching "modemmanager"/"qc"
     whose /proc/<pid>/fd it cannot read -- ModemManager runs as root, so this
     ALWAYS fires, and when DISPLAY is set it re-execs via pkexec, throwing a
     GUI password dialog onto the console and hanging with no output.

ModemManager already lists our diag port as "(ignored)", so there is nothing to
detect. Neutralise the check and drop DISPLAY so no pkexec path exists at all.
"""
import os, sys

os.environ.pop('DISPLAY', None)

from qcsuper.inputs import usb_modem_pyserial as _ump
_ump.UsbModemPyserialConnector.detect_diag_interference = (
    lambda self, *a, **k: None
)

from qcsuper.main import main

if __name__ == '__main__':
    sys.exit(main())
