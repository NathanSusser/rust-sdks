# Run artifacts. Regenerated by `run_matrix.py --run`; a committed sweep is a
# snapshot of one host on one day and must never be pooled with a later one.
runs/
snapshots/
logs/

# Known-answer fixtures. Regenerated by `fixtures/make_fixtures.py`, which is the
# source of truth — the generated tree is ~256MB, dominated by 200 Hz control
# sequence logs.
fixtures/runs/
fixtures/snapshots/
fixtures/_gate_halt_tmp/

# Exported VMAF sources and sweep output. Regenerated by `export-source`; a 10 s 1080p30
# Y4M is ~933 MB, and the synthetic one is deterministic so it is reproducible byte for
# byte rather than worth storing.
vmaf/sources/
vmaf/results.json
vmaf/tmp_vmaf/

__pycache__/
